1 ICON "assets/icons/cshell.ico"
1 VERSIONINFO
FILEVERSION @CSHELL_VERSION_TUPLE@
PRODUCTVERSION @CSHELL_VERSION_TUPLE@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "CShell Terminal\0"
      VALUE "ProductName", "CShell\0"
      VALUE "FileVersion", "@CSHELL_VERSION_STRING@\0"
      VALUE "ProductVersion", "@CSHELL_VERSION_STRING@\0"
      VALUE "OriginalFilename", "CShell.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
